# Nexora AI — Environment Configuration
# Copy this file to .env and fill in your values.

# Application
APP_NAME=Nexora AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Paths (relative to project root)
LOG_DIR=logs
DATA_DIR=data

# Scheduler
SCHEDULER_TIMEZONE=UTC

# Facebook (placeholder — configure when implementing)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_ACCESS_TOKEN=

# YouTube (placeholder — configure when implementing)
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# AI / Content (placeholder — configure when implementing)
OPENAI_API_KEY=

# Content Engine — free Groq API key (get one at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Trend Hunter
TREND_HUNTER_ENABLED_PROVIDERS=google_trends,reddit,news_api,rss,youtube
TREND_HUNTER_SKIP_UNCONFIGURED=true
TREND_HUNTER_FETCH_CONCURRENCY=5
TREND_HUNTER_REQUEST_TIMEOUT_SECONDS=30
TREND_HUNTER_LOG_LEVEL=INFO
TREND_HUNTER_LOG_TO_FILE=true
TREND_HUNTER_REDDIT_CLIENT_ID=
TREND_HUNTER_REDDIT_CLIENT_SECRET=
TREND_HUNTER_REDDIT_USER_AGENT=NexoraAI/TrendHunter/1.0
TREND_HUNTER_NEWS_API_KEY=
TREND_HUNTER_YOUTUBE_API_KEY=
TREND_HUNTER_RSS_FEED_URLS=
